	//수정 update emp set ename=? , job=? , sal=? , hiredate=? where empno=?
	public int updateEmpDto(EmpDto empDto) {
		Connection conn = null;
		PreparedStatement pstmt = null;
		int rowcount = 0;
		
		try {
			    conn = ConnectionPoolHelper.getConnection();
			    String sql="update emp set ename=? , job=? , sal=? , hiredate=? where empno=?";
			    
			    pstmt = conn.prepareStatement(sql);
			    
			    pstmt.setString(1, empDto.getEname());
			    pstmt.setString(2, empDto.getJob());
			    // pstmt.setObject(....)
			    // 혹은 select to_char(hiredate, 'YYYY-MM-DD') 포매팅 구성이 가능하나
			    // 프론트 가공(UI)이 필요 없을 때 편리
			    pstmt.setObject(4, LocalDate.of(empDto.getHiredate().getYear(), empDto.getHiredate().getMonth(), empDto.getHiredate().getDayOfMonth()));
			    pstmt.setInt(4, empDto.getSal());
			    pstmt.setInt(5, empDto.getEmpno());
			    
			    rowcount = pstmt.executeUpdate();

		} catch (Exception e) {
			System.out.println(e.getMessage());
		}finally {
			ConnectionPoolHelper.close(pstmt);
			ConnectionPoolHelper.close(conn);
		}
		return rowcount;
	}

	//	삭제 delete from emp where empno=?
	public int deleteEmpDto(int empno) {
		Connection conn = null;
		PreparedStatement pstmt = null;
		int rowcount = 0;
		
		try {
			    conn = ConnectionPoolHelper.getConnection();
			    String sql="delete from emp where empno=?";
			    
			    pstmt = conn.prepareStatement(sql);

			    pstmt.setInt(1, empno);
			  
			    rowcount = pstmt.executeUpdate();

		} catch (Exception e) {
			System.out.println(e.getMessage());
		}finally {
			ConnectionPoolHelper.close(pstmt);
			ConnectionPoolHelper.close(conn);
		}
		return rowcount;
	}
