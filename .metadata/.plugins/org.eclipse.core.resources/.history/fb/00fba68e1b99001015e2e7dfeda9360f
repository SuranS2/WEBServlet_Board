<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<jsp:include page="/header.jsp" />

	<div class="card" style="margin:10rem;">
		<div class="card-body">
			사원번호 <h5 class="card-title">${requestScope.empdetail.empno}</h5>
			<hr>
			이름 <p class="card-text">${requestScope.empdetail.ename}</p>
			<hr>
			직무 <p class="card-text">${requestScope.empdetail.job}</p>
			<hr>
			매니저번호 <p class="card-text">${requestScope.empdetail.mgr}</p>
			<hr>
			입사일 <p class="card-text">${requestScope.empdetail.hiredate}</p>
			<hr>
			급여 <p class="card-text">${requestScope.empdetail.sal}</p>
			<hr>
			커미션 <p class="card-text">${requestScope.empdetail.comm}</p>
			<hr>
			부서번호 <p class="card-text">${requestScope.empdetail.deptno}</p>
			<hr>
			<a class="btn btn-primary" href="empdelete.do?ename=${requestScope.empdetail.ename}">삭제하기</a>
			<a class="btn btn-primary" href="empupdate.do?ename=${requestScope.empdetail.ename}">수정하기</a>
		</div>
	</div>
</body>
</html>