<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<jsp:include page="/header.jsp" />
	<div style="margin: 100px;">
		<div style="margin: 100px;">
		<form action="${pageContext.request.contextPath}/empinsert.do" method="post">
			<div class="mb-3">
				<label for="formGroupExampleInput" class="form-label">사원번호</label> 
				<input
					value="${requestScope.empupdate.empno}"
					type="text" class="form-control" name="ename" placeholder="사원번호 입력"
					required="required">
			</div>
			<div class="mb-3">
				<label for="formGroupExampleInput" class="form-label">이름</label>
				<input value="${requestScope.empupdate.ename}" type="text" class="form-control" name="ename"
					placeholder="이름 입력" required="required">
			</div>
			<div class="mb-3">
				<label for="formGroupExampleInput" class="form-label">직무</label>
				<input value="${requestScope.empupdate.job}" type="text" class="form-control" name="job"
					placeholder="직무 입력" required="required">
			</div>
			<div class="mb-3">
				<label for="formGroupExampleInput" class="form-label">매니저번호</label>
				<input value="${requestScope.empupdate.mgr}" type="text" class="form-control" name="mgr"
					placeholder="매니저 번호 입력" required="required">
			</div>
			<div class="mb-3">
				<label for="formGroupExampleInput" class="form-label">입사일</label>
				<input value="${requestScope.empupdate.hiredate}" type="date" class="form-control" name="hiredate"
					placeholder="입사일 입력" required="required">
			</div>
			<div class="mb-3">
				<label for="formGroupExampleInput" class="form-label">급여</label>
				<input value="${requestScope.empupdate.sal}" type="text" class="form-control" name="sal"
					placeholder="급여 입력" required="required">
			</div>
			<div class="mb-3">
				<label for="formGroupExampleInput" class="form-label">커미션</label>
				<input value="${requestScope.empupdate.comm}" type="text" class="form-control" name="comm"
					placeholder="커미션 입력" required="required">
			</div>
			<div class="mb-3">
				<label for="formGroupExampleInput" class="form-label">부서번호</label>
				<input value="${requestScope.empupdate.deptno}" type="text" class="form-control" name="deptno"
					placeholder="부서번호 입력" required="required">
			</div>
			<div class="col-12">
				<button type="submit" class="btn btn-primary">직원 추가</button>
			</div>
			<div class="col-12">
				<button onclick="location.href = './defualt.jsp'" type="button"
					class="btn btn-light">취소</button>
			</div>
		</form>
	</div>
</body>
</html>